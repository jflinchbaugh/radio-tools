{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.scicloj/clay {:mvn/version "2.0.24"}
        org.scicloj/plotje {:mvn/version "0.18.0"}}
 :aliases
 {:run-m {:main-opts ["-m" "hf-power-analysis.core"]}
  :run-x {:ns-default hf-power-analysis.core
          :exec-fn -main}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :dev {:extra-paths ["dev" "notebooks"]
        :extra-deps {cider/cider-nrepl {:mvn/version "0.64.1"}
                     nrepl/nrepl {:mvn/version "1.8.0"}
                     refactor-nrepl/refactor-nrepl {:mvn/version "3.15.0"}}}
  :cider {:extra-deps {cider/cider-nrepl {:mvn/version "0.64.1"}
                       nrepl/nrepl {:mvn/version "1.8.0"}
                       refactor-nrepl/refactor-nrepl {:mvn/version "3.15.0"}}}
  :clay {:extra-paths ["dev" "notebooks"]
         :extra-deps {cider/cider-nrepl {:mvn/version "0.64.1"}
                      nrepl/nrepl {:mvn/version "1.8.0"}
                      refactor-nrepl/refactor-nrepl {:mvn/version "3.15.0"}}
         :main-opts ["-m" "scicloj.clay.v2.main"]}}}
