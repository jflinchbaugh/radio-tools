{:source-path "notebooks/index.clj"
 :format [:quarto :html]
 :quarto
 {:format
  {:html
   {:toc true
    :toc-depth 4
    :theme :cosmo
    :include-in-header
    [{:text "<style>
.sourceClojure details.code-fold { margin-bottom: 0.5rem; }
.sourceClojure details.code-fold > summary {
  cursor: pointer;
  display: inline-block;
  padding: 0.2rem 0.55rem;
  font-size: 0.8rem;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #495057;
  background-color: #f8f9fa;
  border: 1px solid #dee2e6;
  border-radius: 0.25rem;
  user-select: none;
  margin-bottom: 0.35rem;
}
.sourceClojure details.code-fold > summary:hover { background-color: #e9ecef; }
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.sourceClojure').forEach(function(sc) {
    if (sc.querySelector('details.code-fold')) return;
    var details = document.createElement('details');
    details.className = 'code-fold';
    var summary = document.createElement('summary');
    summary.textContent = 'Code';
    details.appendChild(summary);
    while (sc.firstChild) {
      details.appendChild(sc.firstChild);
    }
    sc.appendChild(details);
  });
});
</script>"}]}}}}
